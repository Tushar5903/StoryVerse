{
  "info":{"name":"StoryVerse Complete API","description":"Rebuilt from the current controllers. Run folders in order: Auth, Users/Profile, Books, Chapters, Reviews, Admin. File requests use {{thumbnail_path}} or {{profile_image_path}}; attach a real local image in Postman before running.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"base_url","value":"http://localhost:8081/api"},{"key":"jwt_token","value":""},{"key":"admin_jwt_token","value":""},{"key":"reader_jwt_token","value":""},{"key":"refresh_token","value":""},{"key":"author_id","value":""},{"key":"user_author_id","value":""},{"key":"user_book_id","value":""},{"key":"admin_book_id","value":""},{"key":"chapter_id","value":""},{"key":"review_id","value":""},{"key":"user_id","value":""},{"key":"password","value":"Password123!"},{"key":"user_email","value":""},{"key":"user_username","value":""},{"key":"admin_email","value":""},{"key":"admin_username","value":""},{"key":"reader_email","value":""},{"key":"reader_username","value":""},{"key":"thumbnail_path","value":""},{"key":"profile_image_path","value":""}],
  "item":[
    {"name":"Auth","item":[
      {"name":"Register User","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["const s=Date.now(); pm.collectionVariables.set('user_email',`postman.user.${s}@example.com`); pm.collectionVariables.set('user_username',`postman_user_${s}`);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Postman User\",\n  \"username\": \"{{user_username}}\",\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"USER\"\n}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/auth/register"}},
      {"name":"Login User","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200)); const d=pm.response.json(); pm.collectionVariables.set('jwt_token',d.accessToken); pm.collectionVariables.set('refresh_token',d.refreshToken); pm.collectionVariables.set('user_id',d.userId);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{user_email}}\",\"password\":\"{{password}}\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/auth/login"}},
      {"name":"Register Admin","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["const s=Date.now(); pm.collectionVariables.set('admin_email',`postman.admin.${s}@example.com`); pm.collectionVariables.set('admin_username',`postman_admin_${s}`);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Postman Admin\",\"username\":\"{{admin_username}}\",\"email\":\"{{admin_email}}\",\"password\":\"{{password}}\",\"role\":\"ADMIN\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/auth/register"}},
      {"name":"Login Admin","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200)); pm.collectionVariables.set('admin_jwt_token',pm.response.json().accessToken);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{admin_email}}\",\"password\":\"{{password}}\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/auth/login"}},
      {"name":"Register Reader","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["const s=Date.now(); pm.collectionVariables.set('reader_email',`postman.reader.${s}@example.com`); pm.collectionVariables.set('reader_username',`postman_reader_${s}`);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Postman Reader\",\"username\":\"{{reader_username}}\",\"email\":\"{{reader_email}}\",\"password\":\"{{password}}\",\"role\":\"USER\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/auth/register"}},
      {"name":"Login Reader","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200)); pm.collectionVariables.set('reader_jwt_token',pm.response.json().accessToken);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{reader_email}}\",\"password\":\"{{password}}\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/auth/login"}},
      {"name":"Refresh Token","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"refreshToken\":\"{{refresh_token}}\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/auth/refresh"}},
      {"name":"Forgot Password","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{user_email}}\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/auth/forgot-password"}},
      {"name":"Reset Password","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"token\":\"{{password_reset_token}}\",\"newPassword\":\"NewPassword123!\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/auth/reset-password"}},
      {"name":"Logout","request":{"method":"POST","description":"Requires the access token and revokes the refresh token in the database.","header":[{"key":"Content-Type","value":"application/json"}],"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"body":{"mode":"raw","raw":"{\"refreshToken\":\"{{refresh_token}}\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/auth/logout"}}
    ]},
    {"name":"Users/Profile","item":[
      {"name":"Get User Profile","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"url":"{{base_url}}/users/me"}},
      {"name":"Update User Profile with Image","request":{"method":"PUT","description":"Attach a real image file to image; Postman cannot embed binary files.","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"body":{"mode":"formdata","formdata":[{"key":"name","value":"Updated Postman User","type":"text"},{"key":"bio","value":"Updated profile biography","type":"text"},{"key":"image","type":"file","src":"{{profile_image_path}}"}]},"url":"{{base_url}}/users/me"}},
      {"name":"Get Admin Profile","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"url":"{{base_url}}/users/me"}},
      {"name":"Update Admin Profile with Image","request":{"method":"PUT","description":"Attach a real image file to image; Postman cannot embed binary files.","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"body":{"mode":"formdata","formdata":[{"key":"name","value":"Updated Postman Admin","type":"text"},{"key":"bio","value":"Updated administrator biography","type":"text"},{"key":"image","type":"file","src":"{{profile_image_path}}"}]},"url":"{{base_url}}/users/me"}}
    ]},
    {"name":"Books","item":[
      {"name":"List Published Books","request":{"method":"GET","url":"{{base_url}}/books?page=0&size=20"}},
      {"name":"Create User Book","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('201',()=>pm.response.to.have.status(201)); const d=pm.response.json(); pm.collectionVariables.set('user_book_id',d.id); pm.collectionVariables.set('user_author_id',d.authorId);"]}}],"request":{"method":"POST","description":"Attach a real JPEG/PNG/WebP/GIF to thumbnail. The request JSON part contains only the title; the author is automatic.","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"body":{"mode":"formdata","formdata":[{"key":"request","value":"{\"title\":\"Postman User Thumbnail Book\"}","type":"text","contentType":"application/json"},{"key":"thumbnail","type":"file","src":"{{thumbnail_path}}"}]},"url":"{{base_url}}/books"}},
      {"name":"List My Books","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"url":"{{base_url}}/books/mine?page=0&size=20"}},
      {"name":"Get User Book","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"url":"{{base_url}}/books/{{user_book_id}}"}},
      {"name":"Complete User Book","request":{"method":"PUT","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"body":{"mode":"raw","raw":"{\"description\":\"A complete demo description for the user book.\",\"subtitle\":\"A new beginning\",\"genre\":\"Fantasy\",\"language\":\"English\",\"tags\":[\"demo\",\"fantasy\"]}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/books/{{user_book_id}}/details"}},
      {"name":"Update User Book Thumbnail","request":{"method":"PUT","description":"Attach a real image to thumbnail to replace the existing thumbnail.","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"body":{"mode":"formdata","formdata":[{"key":"request","value":"{\"title\":\"Postman User Thumbnail Book\",\"description\":\"Updated book description\",\"genre\":\"Fantasy\",\"language\":\"English\",\"tags\":[\"updated\"],\"authorId\":{{user_author_id}}}","type":"text","contentType":"application/json"},{"key":"thumbnail","type":"file","src":"{{thumbnail_path}}"}]},"url":"{{base_url}}/books/{{user_book_id}}"}},
      {"name":"Create Admin Author","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('201',()=>pm.response.to.have.status(201)); pm.collectionVariables.set('author_id',pm.response.json().id);"]}}],"request":{"method":"POST","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Postman Admin Author\",\"biography\":\"A realistic admin author record\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/authors"}},
      {"name":"Create Admin Book","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('201',()=>pm.response.to.have.status(201)); pm.collectionVariables.set('admin_book_id',pm.response.json().id);"]}}],"request":{"method":"POST","description":"Attach a real image to thumbnail. Admin books are published immediately.","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"body":{"mode":"formdata","formdata":[{"key":"request","value":"{\"title\":\"Postman Admin Thumbnail Book\",\"description\":\"A realistic published admin book\",\"genre\":\"Fiction\",\"language\":\"English\",\"tags\":[\"admin\",\"demo\"],\"authorId\":{{author_id}}}","type":"text","contentType":"application/json"},{"key":"thumbnail","type":"file","src":"{{thumbnail_path}}"}]},"url":"{{base_url}}/books/review"}},
      {"name":"Get Admin Book","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"url":"{{base_url}}/books/{{admin_book_id}}"}},
      {"name":"Publish User Book","request":{"method":"POST","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"url":"{{base_url}}/books/{{user_book_id}}/publish"}},
      {"name":"Delete User Book","request":{"method":"DELETE","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"url":"{{base_url}}/books/{{user_book_id}}"}}
    ]},
    {"name":"Chapters","item":[
      {"name":"Create Chapter","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('201',()=>pm.response.to.have.status(201)); pm.collectionVariables.set('chapter_id',pm.response.json().id);"]}}],"request":{"method":"POST","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"chapterNumber\":1,\"chapterTitle\":\"The Beginning\",\"chapterContent\":\"A realistic chapter with an opening scene.\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/books/{{user_book_id}}/chapters"}},
      {"name":"List Chapters","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"url":"{{base_url}}/books/{{user_book_id}}/chapters"}},
      {"name":"Get Chapter","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"url":"{{base_url}}/books/{{user_book_id}}/chapters/{{chapter_id}}"}},
      {"name":"Update Chapter","request":{"method":"PUT","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"chapterNumber\":1,\"chapterTitle\":\"The Beginning Revised\",\"chapterContent\":\"Revised chapter content.\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/books/{{user_book_id}}/chapters/{{chapter_id}}"}},
      {"name":"Update Chapter Direct Route","request":{"method":"PUT","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"chapterNumber\":1,\"chapterTitle\":\"The Beginning Final\",\"chapterContent\":\"Final chapter content.\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/chapters/{{chapter_id}}"}},
      {"name":"Delete Chapter Nested Route","request":{"method":"DELETE","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"url":"{{base_url}}/books/{{user_book_id}}/chapters/{{chapter_id}}"}},
      {"name":"Get Chapter Direct Route","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"url":"{{base_url}}/chapters/{{chapter_id}}"}},
      {"name":"Delete Chapter Direct Route","request":{"method":"DELETE","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"url":"{{base_url}}/chapters/{{chapter_id}}"}}
    ]},
    {"name":"Reviews","item":[
      {"name":"Admin Authored Book - expected 403","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('403 expected',()=>pm.response.to.have.status(403));"]}}],"request":{"method":"POST","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"bookId\":{{admin_book_id}},\"verdict\":\"SKIP\",\"message\":\"Admin-authored books cannot be reviewed.\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/reviews"}},
      {"name":"Self Authored Book - expected 403","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('403 expected',()=>pm.response.to.have.status(403));"]}}],"request":{"method":"POST","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{jwt_token}}"}]},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"bookId\":{{user_book_id}},\"verdict\":\"SKIP\",\"message\":\"Owners cannot review their own books.\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/reviews"}},
      {"name":"Create Reader Review - GO_FOR_IT","event":[{"listen":"test","script":{"type":"javascript","exec":["pm.test('201',()=>pm.response.to.have.status(201)); pm.collectionVariables.set('review_id',pm.response.json().id);"]}}],"request":{"method":"POST","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{reader_jwt_token}}"}]},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"bookId\":{{user_book_id}},\"verdict\":\"GO_FOR_IT\",\"message\":\"Strong premise and engaging opening.\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/reviews"}},
      {"name":"Create Reader Review - PERFECTION","request":{"method":"POST","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{reader_jwt_token}}"}]},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"bookId\":{{admin_book_id}},\"verdict\":\"PERFECTION\",\"message\":\"Excellent finished story.\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/reviews"}},
      {"name":"List Reviews","request":{"method":"GET","url":"{{base_url}}/reviews?bookId={{user_book_id}}&page=0&size=20"}},
      {"name":"Get Review","request":{"method":"GET","url":"{{base_url}}/reviews/{{review_id}}"}},
      {"name":"Update Review - NEEDS_WORK","request":{"method":"PUT","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{reader_jwt_token}}"}]},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"verdict\":\"NEEDS_WORK\",\"message\":\"Needs another editing pass.\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/reviews/{{review_id}}"}},
      {"name":"Delete Review","request":{"method":"DELETE","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{reader_jwt_token}}"}]},"url":"{{base_url}}/reviews/{{review_id}}"}}
    ]},
    {"name":"Admin","item":[
      {"name":"Dashboard","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"url":"{{base_url}}/admin/dashboard"}},
      {"name":"List All Books","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"url":"{{base_url}}/admin/books?page=0&size=50"}},
      {"name":"List All Users","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"url":"{{base_url}}/admin/users?page=0&size=50"}},
      {"name":"List Authors with USER or ADMIN type","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"url":"{{base_url}}/admin/authors?page=0&size=50"}},
      {"name":"List Published Books by User","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"url":"{{base_url}}/admin/users/{{user_id}}/books?page=0&size=50"}},
      {"name":"List Public Authors","request":{"method":"GET","url":"{{base_url}}/authors?page=0&size=50"}},
      {"name":"Get Author","request":{"method":"GET","url":"{{base_url}}/authors/{{author_id}}"}},
      {"name":"Get Author Books","request":{"method":"GET","url":"{{base_url}}/authors/{{author_id}}/books"}},
      {"name":"Update Author","request":{"method":"PUT","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Postman Admin Author Updated\",\"biography\":\"Updated author biography\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/authors/{{author_id}}"}},
      {"name":"Upload Author Image","request":{"method":"POST","description":"Attach a real image file to file; this is the existing Cloudinary upload endpoint.","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{profile_image_path}}"}]},"url":"{{base_url}}/upload/author-image"}},
      {"name":"Upload Book Cover","request":{"method":"POST","description":"Attach a real image file to file; this is the existing Cloudinary upload endpoint.","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_jwt_token}}"}]},"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{thumbnail_path}}"}]},"url":"{{base_url}}/upload/book-cover"}}
    ]}
  ]
}
